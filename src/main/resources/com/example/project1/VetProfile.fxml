<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fx:id="pane1" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" prefHeight="1100.0" prefWidth="1374.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.project1.VetProfileController">
    <content>
        <AnchorPane prefHeight="1108.0" prefWidth="1374.0" style="-fx-background-color: #E4C7A2;">
            <children>
            <!-- Header Section -->
                <AnchorPane prefHeight="206.0" prefWidth="1374.0" style="-fx-background-color: #8B0000;">
                    <children>
                        <Label fx:id="PawCare" layoutX="101.0" layoutY="26.0" prefHeight="64.0" prefWidth="158.0" text="PawCare" textFill="WHITE">
                            <font>
                                <Font name="Brush Script MT Italic" size="48.0" />
                            </font>
                        </Label>
                        <Button fx:id="AlertsReceived" layoutX="302.0" layoutY="76.0" mnemonicParsing="false" style="-fx-background-color: #8B0000;" text="Alerts Received" textFill="WHITE" />
                        <Button fx:id="AnimalProfiles" layoutX="501.0" layoutY="76.0" mnemonicParsing="false" style="-fx-background-color: #8B0000;" text="Animal Profiles" textFill="WHITE" />
                        <Button fx:id="AdoptionRequests" layoutX="687.0" layoutY="76.0" mnemonicParsing="false" style="-fx-background-color: #8B0000;" text="Adoption Requests" textFill="WHITE" />
                        <Button fx:id="ContactVet" layoutX="902.0" layoutY="76.0" mnemonicParsing="false" style="-fx-background-color: #8B0000;" text="Contact Vet" textFill="WHITE" />
                        <Button fx:id="DonationsMade" layoutX="1055.0" layoutY="76.0" mnemonicParsing="false" style="-fx-background-color: #8B0000;" text="Donations Made" textFill="WHITE" />
                    </children>
                </AnchorPane>
                <!-- Main Content Section -->
                <AnchorPane layoutX="265.0" layoutY="168.0" prefHeight="866.0" prefWidth="808.0" style="-fx-background-color: #ffffff;">
                    <children>
                        <Label layoutX="285.0" layoutY="50.0" text="Vet Profile" style="-fx-font-size: 36px; -fx-font-weight: bold;" />

                    <!-- Vet Information Section -->
                        <VBox layoutX="100.0" layoutY="120.0" prefHeight="700.0" prefWidth="682.0" spacing="20" alignment="TOP_LEFT">

                        <!-- Vet's Name -->
                        <Label fx:id="vetName" text="Dr. John Doe" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

                        <!-- Vet's Location -->
                        <Label fx:id="vetLocation" text="Location: City Center, Block A" style="-fx-font-size: 18px;" />

                        <!-- Vet's Phone Number -->
                        <Label fx:id="vetPhone" text="Phone: +123456789" style="-fx-font-size: 18px;" />

                        <!-- Vet's Email -->
                        <Label fx:id="vetEmail" text="Email: johndoe@example.com" style="-fx-font-size: 18px;" />
                    </VBox>

                    <!-- Go Back Button -->
                    <Button fx:id="goBackButton" text="Go Back" layoutX="100.0" layoutY="820.0" style="-fx-background-color: #8B0000; -fx-text-fill: white;" />
                </children>
            </AnchorPane>

        </children>
    </AnchorPane>
</content>
</ScrollPane>

